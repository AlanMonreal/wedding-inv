---

<Layout
	title="Guía del invitado — Jimena & Alan"
	description="Recomendaciones de hospedaje, estilistas, maquillaje, cocina local y tips para quienes viajan a la boda de Jimena y Alan en Cd. Victoria, Tamaulipas."
>
	<header class="guide-hero">
		<a class="guide-back" href="/">← Volver a la invitación</a>
		<p class="eyebrow guide-eyebrow" data-reveal>Guía del invitado</p>
		<h1 class="guide-title" data-reveal>Para los que viajan</h1>
		<p class="guide-lede" data-reveal>
			Sabemos que muchos de ustedes vienen desde lejos hasta Cd. Victoria, Tamaulipas. Aquí está
			todo lo que nosotros les recomendaríamos: dónde hospedarte, dónde peinarte, quién te maquilla,
			dónde comer y los pendientes prácticos del fin de semana.
		</p>
	</header>

	<Marquee text="Cd. Victoria, Tamaulipas — 15 de noviembre de 2026 —" />

	<main>
		<!-- Hotels — wide layout so the short pair reads as a curated spread, not a sparse column -->
		<section id="hoteles" class="guide-section guide-section--ivory guide-section--wide">
			<div class="guide-section-inner">
				<div class="guide-section-intro">
					<div class="guide-section-intro-text">
						<p class="eyebrow guide-section-eyebrow" data-reveal>Para quienes vienen de fuera</p>
						<h2 class="guide-section-title" data-reveal>Dónde hospedarte</h2>
						<p class="guide-section-lede" data-reveal>
							Estas son las opciones que más nos gustan cerca de la recepción — a solo 5 minutos
							de Salón Andare.
						</p>
					</div>
					<figure class="guide-photo" data-reveal>
						<Image
							src={photoStairs}
							alt="Alan y Jimena sentados en una escalera de madera"
							widths={[480, 768, 1080, 1600]}
							sizes="(min-width: 900px) 44vw, 92vw"
							quality={80}
							loading="lazy"
						/>
					</figure>
				</div>
				<div class="guide-list">
					{HOTELS.map((entry, i) => <RecommendationCard index={i + 1} {...entry} />)}
				</div>
			</div>
		</section>

		<!-- Hair & makeup -->
		<section id="belleza" class="guide-section guide-section--olive">
			<div class="guide-section-inner">
				<div class="guide-section-intro">
					<p class="eyebrow" data-reveal>Antes de la boda</p>
					<h2 class="guide-section-title" data-reveal>Peinado y maquillaje</h2>
					<figure class="guide-photo" data-reveal>
						<Image
							src={photoHug}
							alt="Jimena abrazando a Alan por la espalda"
							widths={[480, 768, 1080, 1600]}
							sizes="(min-width: 900px) 34vw, 92vw"
							quality={80}
							loading="lazy"
						/>
					</figure>
				</div>
				<div class="guide-list">
					{BEAUTY_FEATURED.map((entry, i) => <RecommendationCard index={i + 1} {...entry} />)}
					<button class="beauty-more" type="button" data-beauty-open aria-haspopup="dialog" aria-controls="beauty-dialog" data-reveal>
						Ver más opciones →
					</button>
				</div>
			</div>
		</section>

		<!-- Food -->
		<section id="comida" class="guide-section guide-section--ivory">
			<div class="guide-section-inner">
				<div class="guide-section-intro">
					<p class="eyebrow guide-section-eyebrow" data-reveal>Para probar la ciudad</p>
					<h2 class="guide-section-title" data-reveal>Dónde comer</h2>
					<p class="guide-section-lede" data-reveal>
						Un mapa muy personal — del café de especialidad de la mañana a las gorditas del
						mediodía.
					</p>
					<figure class="guide-photo" data-reveal>
						<Image
							src={photoFood}
							alt="Retrato editorial de Alan y Jimena"
							widths={[480, 768, 1080, 1600]}
							sizes="(min-width: 900px) 34vw, 92vw"
							quality={80}
							loading="lazy"
						/>
					</figure>
				</div>
				<div class="guide-list">
					{RESTAURANTS.map((entry, i) => <RecommendationCard index={i + 1} {...entry} />)}
				</div>
			</div>
		</section>

		<!-- Misc -->
		<section id="miscelaneos" class="guide-section guide-section--olive">
			<div class="guide-section-inner">
				<div class="guide-section-intro">
					<p class="eyebrow" data-reveal>Durante el fin de semana</p>
					<h2 class="guide-section-title" data-reveal>Lo práctico</h2>
					<figure class="guide-photo" data-reveal>
						<Image
							src={photoDetail}
							alt="Las manos de Alan y Jimena entrelazadas, con el anillo de compromiso"
							widths={[480, 768, 1080, 1600]}
							sizes="(min-width: 900px) 34vw, 92vw"
							quality={80}
							loading="lazy"
						/>
					</figure>
				</div>
				<div class="guide-list">
					{MISC.map((entry, i) => <RecommendationCard index={i + 1} {...entry} />)}
				</div>
			</div>
		</section>
	</main>

	<footer class="guide-footer">
		<p class="guide-footer-monogram" aria-hidden="true">J&A</p>
		<a class="guide-footer-link" href="/">Volver a la invitación</a>
	</footer>

	<!--
		Beauty dialog lives at the top of the layout, outside the belleza
		section, so its flow position doesn't influence scroll when the
		browser promotes it into the top layer via showModal().
	-->
	<dialog class="beauty-dialog" id="beauty-dialog" aria-labelledby="beauty-dialog-title">
		<form method="dialog" class="beauty-dialog-close-form">
			<button class="beauty-dialog-close" type="submit" aria-label="Cerrar">×</button>
		</form>
		<p class="eyebrow beauty-dialog-eyebrow">Más opciones</p>
		<h3 class="beauty-dialog-title" id="beauty-dialog-title">Peinado y maquillaje</h3>
		<div class="beauty-dialog-list">
			{BEAUTY_MORE.map((entry, i) => <RecommendationCard index={i + 1} {...entry} />)}
		</div>
	</dialog>
</Layout>

<script>
	/**
	 * Wires up the "Ver más opciones" trigger for the beauty dialog. Uses
	 * the native <dialog> element — ESC closes it, the close button is a
	 * plain <form method="dialog"> submit (so it works even before this
	 * script runs), and clicking the backdrop dismisses the dialog.
	 */
	const dialog = document.getElementById('beauty-dialog') as HTMLDialogElement | null;
	const openBtn = document.querySelector<HTMLButtonElement>('[data-beauty-open]');

	openBtn?.addEventListener('click', () => dialog?.showModal());

	dialog?.addEventListener('click', (event) => {
		if (event.target !== dialog) return;
		const rect = dialog.getBoundingClientRect();
		const clickedOutside =
			event.clientY < rect.top ||
			event.clientY > rect.bottom ||
			event.clientX < rect.left ||
			event.clientX > rect.right;
		if (clickedOutside) dialog.close();
	});
</script>

<style>
	/* ---- Hero ---- */
	.guide-hero {
		background: var(--wine);
		color: var(--ivory);
		padding: clamp(2rem, 6vh, 4rem) var(--gutter) clamp(4rem, 10vh, 7rem);
		display: grid;
		gap: clamp(1.5rem, 4vh, 2.5rem);
		max-width: none;
	}

	.guide-back {
		justify-self: start;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ivory-dim);
		text-decoration: none;
		border-bottom: 1px solid rgb(244 236 221 / 0.4);
		padding-bottom: 0.35em;
		margin-bottom: clamp(1.5rem, 5vh, 3rem);
	}

	.guide-back:hover {
		color: var(--ivory);
		border-color: currentColor;
	}

	.guide-eyebrow {
		color: var(--ivory-dim);
	}

	.guide-title {
		font-family: var(--font-display);
		font-weight: 480;
		font-size: clamp(3rem, 10vw, 8rem);
		line-height: 0.95;
		letter-spacing: -0.01em;
	}

	.guide-lede {
		max-width: var(--measure);
		font-size: clamp(1rem, 1.8vw, 1.2rem);
		opacity: 0.9;
	}

	/* ---- Sections ---- */
	.guide-section {
		padding: clamp(4rem, 12vh, 8rem) var(--gutter);
	}

	.guide-section--ivory {
		background: var(--ivory);
		color: var(--ink);
	}

	.guide-section--olive {
		background: var(--olive-deep);
		color: var(--ivory);
	}

	.guide-section-inner {
		max-width: 72rem;
		margin-inline: auto;
		display: grid;
		gap: clamp(2.5rem, 6vw, 5rem);
	}

	@media (min-width: 900px) {
		.guide-section-inner {
			grid-template-columns: 4fr 5fr;
			align-items: start;
		}
	}

	.guide-section-intro {
		display: grid;
		gap: 1.5rem;
		align-content: start;
	}

	.guide-section-eyebrow {
		color: var(--crimson-deep);
	}

	.guide-section-title {
		font-family: var(--font-display);
		font-weight: 460;
		font-size: clamp(2.4rem, 6vw, 4.8rem);
		line-height: 1;
		letter-spacing: -0.01em;
	}

	.guide-section-lede {
		max-width: var(--measure);
		opacity: 0.85;
	}

	.guide-photo {
		margin-top: 1rem;
	}

	.guide-photo img {
		width: 100%;
		height: auto;
	}

	.guide-list {
		display: grid;
		gap: clamp(2rem, 4vh, 3rem);
		align-content: start;
	}

	/* Cards draw a border with currentColor; soften it per ground */
	.guide-section--ivory .guide-list {
		color: var(--ink);
	}

	/* ---- Footer ---- */
	.guide-footer {
		background: var(--wine);
		color: var(--ivory);
		text-align: center;
		padding: clamp(3rem, 8vh, 5rem) var(--gutter) 2.5rem;
		display: grid;
		gap: 1rem;
		justify-items: center;
	}

	.guide-footer-monogram {
		font-family: var(--font-display);
		font-style: italic;
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		line-height: 1;
	}

	.guide-footer-link {
		font-size: 0.78rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid rgb(244 236 221 / 0.4);
		padding-bottom: 0.3em;
	}

	.guide-footer-link:hover {
		border-color: currentColor;
	}

	/* Text stack wrapper — used inside .guide-section-intro when the intro
	   needs to sit side-by-side with the photo (see --wide below). Groups
	   eyebrow + title + lede so they count as one grid item instead of
	   three, which is what lets the pair align cleanly. */
	.guide-section-intro-text {
		display: grid;
		gap: 1.25rem;
		align-content: start;
	}

	/* ---- Wide layout (hotels) ----
	   For sections with a short list (e.g. the two hotel picks), the intro
	   becomes an editorial 5fr/6fr row — text stack centered against a
	   cropped portrait photo — with the cards dropped into a two-column
	   grid below. Photo is constrained via aspect-ratio + max-height so it
	   anchors the spread instead of stretching to its natural (very tall)
	   portrait dimensions. */
	@media (min-width: 900px) {
		.guide-section--wide .guide-section-inner {
			grid-template-columns: minmax(0, 1fr);
			gap: clamp(3.5rem, 7vw, 5.5rem);
		}

		.guide-section--wide .guide-section-intro {
			grid-template-columns: 5fr 6fr;
			column-gap: clamp(3rem, 6vw, 5rem);
			row-gap: 1.5rem;
			align-items: center;
		}

		.guide-section--wide .guide-section-intro-text {
			max-width: 26rem;
		}

		.guide-section--wide .guide-photo {
			margin-top: 0;
			max-width: 32rem;
			justify-self: end;
		}

		.guide-section--wide .guide-photo img {
			aspect-ratio: 4 / 5;
			object-fit: cover;
			object-position: center 30%;
			width: 100%;
			max-height: 36rem;
		}

		.guide-section--wide .guide-list {
			grid-template-columns: 1fr 1fr;
			gap: clamp(2rem, 4vw, 3.5rem);
			align-items: start;
		}
	}

	/* ---- Beauty dialog trigger ----
	   Lives as the last item of the belleza .guide-list so it aligns with
	   the featured cards; styled as a text link to match the site's
	   editorial rec-link language. */
	.beauty-more {
		justify-self: start;
		margin-top: 0.5rem;
		font-family: var(--font-body);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		background: none;
		border: none;
		color: inherit;
		cursor: pointer;
		border-bottom: 1px solid currentColor;
		padding: 0 0 0.35em 0;
		transition: opacity 0.2s ease;
	}

	.beauty-more:hover {
		opacity: 0.65;
	}

	/* ---- Beauty dialog ----
	   The UA `dialog:modal` stylesheet only pins the block axis (top/bottom),
	   so a modal with a max-width sits at the inline-start (top-left) unless
	   we anchor the inline axis too. Explicit `position: fixed; inset: 0;
	   margin: auto;` recreates a centered top-layer overlay without falling
	   back to `position: relative` (which caused the scroll-to-flow-position
	   bug earlier). */
	.beauty-dialog {
		position: fixed;
		inset: 0;
		margin: auto;
		background: var(--ivory);
		color: var(--ink);
		border: none;
		padding: clamp(2.5rem, 6vw, 4.5rem);
		max-width: min(46rem, 92vw);
		width: 100%;
		max-height: 88svh;
		overflow-y: auto;
	}

	.beauty-dialog::backdrop {
		background: rgb(51 5 10 / 0.72);
		backdrop-filter: blur(6px);
	}

	.beauty-dialog-close-form {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		margin: 0;
	}

	.beauty-dialog-close {
		background: none;
		border: none;
		font-family: var(--font-display);
		font-size: 2rem;
		line-height: 1;
		cursor: pointer;
		color: currentColor;
		padding: 0.5rem 0.75rem;
		transition: opacity 0.2s ease;
	}

	.beauty-dialog-close:hover {
		opacity: 0.55;
	}

	.beauty-dialog-eyebrow {
		color: var(--crimson-deep);
	}

	.beauty-dialog-title {
		font-family: var(--font-display);
		font-weight: 460;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		line-height: 1;
		margin-top: 0.75rem;
		margin-bottom: clamp(2rem, 4vh, 2.75rem);
