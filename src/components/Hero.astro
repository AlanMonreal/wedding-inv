---
/**
 * Full-viewport hero: the couple photographed against the crimson studio
 * backdrop, with the invitation masthead set over the backdrop's negative
 * space. The masthead row carries a link to the guest guide; a gradient
 * foot dissolves the photo into the page ground so the site reads as a
 * continuation of the studio wall.
 *
 * @prop {string} coupleNames - Names as they appear on the masthead.
 * @prop {string} dateLabel - Human-readable wedding date.
 */
import { Image } from 'astro:assets';
import heroPhoto from '../assets/images/Jimena & Alan-112-top.jpg';
// import heroPhoto from '../assets/images/Jimena & Alan-122-must.jpg';
// import heroPhoto from '../assets/images/Jimena & Alan-28-edit.jpeg';

interface Props {
	coupleNames: string;
	dateLabel: string;
}

const { coupleNames, dateLabel } = Astro.props;
const [firstName, secondName] = coupleNames.split(' & ');
---

<header class="hero">
	<!-- sizes="(orientation: portrait) 320vw, 100vw" -->
	<Image
		src={heroPhoto}
		alt={`${coupleNames} frente al fondo rojo de su sesión de compromiso`}
		class="hero-photo"
		widths={[768, 1280, 1920, 2560, 3840]}
		sizes="(orientation: portrait) 320vw, 100vw"
		quality={80}
		loading="eager"
		fetchpriority="high"
	/>
	<div class="hero-overlay" aria-hidden="true"></div>

	<div class="hero-masthead">
		<div class="hero-top">
			<p class="eyebrow hero-kicker">¡Nos casamos!</p>
			<a class="hero-guide" href="/recomendaciones">Guía del invitado →</a>
		</div>
		<h1 class="hero-names">
			<span class="hero-name">{firstName}</span>
			<span class="hero-amp" aria-hidden="true">&amp;</span>
			<span class="hero-name hero-name--indent">{secondName}</span>
		</h1>
	</div>

	<div class="hero-foot">
		<p class="hero-date">{dateLabel}</p>
		<a class="hero-scroll" href="#invitacion">Desliza para leer la invitación ↓</a>
	</div>
</header>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		display: grid;
		grid-template-rows: 1fr auto;
		isolation: isolate;
	}

	.hero-photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 75%;
		z-index: -2;
	}
	/* object-position: 50% 78%; */
	/* object-position: 50% 35%; */
	/* object-position: 50% 25%; */

	/* Dissolves the photo's vignette into the page ground below */
	.hero-overlay {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(to bottom, rgb(51 5 10 / 0.35), transparent 26%),
			linear-gradient(to bottom, transparent 62%, var(--wine) 100%);
	}

	.hero-masthead {
		padding: clamp(1.5rem, 4vh, 3.5rem) var(--gutter) 0;
	}

	.hero-top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem 2rem;
		flex-wrap: wrap;
		margin-bottom: clamp(0.75rem, 2vh, 1.5rem);
	}

	.hero-kicker {
		color: var(--ivory-dim);
	}

	.hero-guide {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--ivory-dim);
		text-decoration: none;
		border-bottom: 1px solid rgb(244 236 221 / 0.4);
		padding-bottom: 0.35em;
	}

	.hero-guide:hover {
		color: var(--ivory);
		border-color: var(--ivory);
	}

	.hero-names {
		font-family: var(--font-display);
		font-weight: 480;
		font-variation-settings: 'opsz' 96;
		font-size: clamp(3.4rem, 13.5vw, 11.5rem);
		line-height: 0.92;
		letter-spacing: -0.01em;
		color: var(--ivory);
		display: grid;
	}

	.hero-name--indent {
		margin-left: clamp(2.5rem, 14vw, 14rem);
	}

	.hero-amp {
		font-style: italic;
		font-weight: 340;
		font-size: 0.5em;
		line-height: 0.8;
		margin-left: clamp(1rem, 5vw, 5rem);
		color: var(--ivory-dim);
	}

	.hero-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		padding: 0 var(--gutter) clamp(1.5rem, 4vh, 3rem);
	}

	.hero-date {
		font-family: var(--font-display);
		font-style: italic;
		font-size: clamp(1.15rem, 2.6vw, 1.8rem);
		color: var(--ivory);
	}

	.hero-scroll {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--ivory-dim);
		text-decoration: none;
		border-bottom: 1px solid rgb(244 236 221 / 0.4);
		padding-bottom: 0.35em;
	}

	.hero-scroll:hover {
		color: var(--ivory);
		border-color: var(--ivory);
	}
</style>
