---
/**
 * One tile in the guest color palette: a fabric-texture photo paired with
 * the color's name and its common alternate name, so a guest picking an
 * outfit has an exact shade to match instead of guessing from a word.
 * Sized to sit in a single-row "paint chip" lineup (see .dresscode-palette
 * in index.astro), with every other tile lifted on wide desktop viewports.
 *
 * @prop {ImageMetadata} photo - Fabric swatch photo for this color.
 * @prop {string} name - Primary color name.
 * @prop {string} altName - Secondary/alternate name for the same color.
 */
import { Image } from 'astro:assets';

interface Props {
	photo: ImageMetadata;
	name: string;
	altName: string;
}

const { photo, name, altName } = Astro.props;
---

<figure class="swatch">
	<div class="swatch-frame">
		<Image
			src={photo}
			alt={`Muestra de tela en tono ${name}`}
			class="swatch-photo"
			widths={[240, 360, 480, 640]}
			sizes="(min-width: 1200px) 9rem, (min-width: 700px) 20vw, 32vw"
			quality={100}
			loading="lazy"
		/>
	</div>
	<figcaption class="swatch-caption">
		<span class="swatch-name">{name}</span>
		<span class="swatch-alt">{altName}</span>
	</figcaption>
</figure>

<style>
	.swatch {
		flex: 0 0 clamp(6.5rem, 26vw, 9rem);
		display: grid;
		gap: 0.75rem;
	}

	@media (min-width: 1200px) {
		.swatch {
			flex-basis: 8rem;
		}
	}

	.swatch-frame {
		aspect-ratio: 1;
		overflow: hidden;
	}

	.swatch-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	@media (hover: hover) {
		.swatch:hover .swatch-photo {
			transform: scale(1.06);
		}
	}

	/* An up-and-down wave rather than a static row — the same asymmetric-
	   offset idea as the black & white interlude further up the page,
	   turned into a rhythm across all seven tiles instead of just two. */
	@media (min-width: 1200px) {
		.swatch:nth-child(odd) .swatch-frame {
			transform: translateY(0.5rem);
		}

		.swatch:nth-child(even) .swatch-frame {
			transform: translateY(-2.25rem);
		}
	}

	.swatch-caption {
		display: grid;
		gap: 0.15rem;
	}

	.swatch-name {
		font-size: 0.7rem;
		font-weight: 650;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.swatch-alt {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 0.88rem;
		opacity: 0.65;
	}
</style>
