---
/**
 * A recommended hotel for out-of-town guests: name, address, distance to
 * the venue, and a booking link. Rendered as a numbered program entry.
 *
 * @prop {number} index - Position in the recommendation list (1-based).
 * @prop {string} name - Hotel name.
 * @prop {string} address - Street address (dummy text for now).
 * @prop {string} distance - Distance or travel time to the venue.
 * @prop {string} note - One-line reason it's recommended.
 * @prop {string} bookingUrl - Reservation link (opens in a new tab when external).
 */
interface Props {
	index: number;
	name: string;
	address: string;
	distance: string;
	note: string;
	bookingUrl: string;
}

const { index, name, address, distance, note, bookingUrl } = Astro.props;
const isExternal = bookingUrl.startsWith('http');
---

<article class="hotel" data-reveal>
	<p class="hotel-index" aria-hidden="true">{String(index).padStart(2, '0')}</p>
	<div class="hotel-body">
		<h3 class="hotel-name">{name}</h3>
		<p class="hotel-note">{note}</p>
		<p class="hotel-meta">{address}</p>
		<p class="hotel-meta">{distance}</p>
		<a
			class="hotel-link"
			href={bookingUrl}
			target={isExternal ? '_blank' : undefined}
			rel={isExternal ? 'noopener noreferrer' : undefined}
		>
			Reservar
		</a>
	</div>
</article>

<style>
	.hotel {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: clamp(1rem, 3vw, 2.5rem);
		border-top: 1px solid rgb(244 236 221 / 0.25);
		padding-top: 1.5rem;
	}

	.hotel-index {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.1rem;
		opacity: 0.6;
	}

	.hotel-body {
		display: grid;
		gap: 0.4rem;
		justify-items: start;
	}

	.hotel-name {
		font-family: var(--font-display);
		font-weight: 460;
		font-variation-settings: 'opsz' 72;
		font-size: clamp(1.6rem, 3.2vw, 2.4rem);
		line-height: 1.1;
	}

	.hotel-note {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.05rem;
		opacity: 0.9;
	}

	.hotel-meta {
		font-size: 0.9rem;
		opacity: 0.7;
	}

	.hotel-link {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
		padding-bottom: 0.35em;
		margin-top: 0.6rem;
	}

	.hotel-link:hover {
		opacity: 0.65;
	}
</style>
